# Copy to .env (ignored by Git). Never use VITE_ for credentials.
OFFICE_MODE=live
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_COMPANY_ID=your-company-id
PAPERCLIP_API_KEY=your-server-only-key
# Optional workflow role -> stable agent UUID. All company agents appear without this mapping.
# Configure all four for specialist handoffs and delivery pipeline.
PAPERCLIP_AGENT_ROLES='{"orchestrator":"orchestrator-agent-id","developer":"developer-agent-id","browser-qa":"browser-qa-agent-id","reviewer":"reviewer-agent-id"}'
# Production listener (loopback only unless explicitly overridden).
HOST=127.0.0.1
PORT=3000

# Optional server-only GitHub token with read access to delivery PRs.
# Never use a VITE_ prefix for credentials.
# OFFICE_GITHUB_TOKEN=
